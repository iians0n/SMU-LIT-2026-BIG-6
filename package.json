{
  "name": "casepath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "fixtures": "tsx scripts/emit-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
