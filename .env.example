# Model provider. Anything OpenAI-API-compatible works — set OPENAI_BASE_URL to
# point at OpenAI, OpenRouter, Together, Groq, a vLLM server, Ollama, or an
# internal gateway. Copy this file to .env.local and fill in a key.
#
# PRD §8 requires choosing a vendor only after checking privacy controls, cost,
# and accuracy against the demo corpus, and using provider settings or terms
# that prevent training on case content. Check that before pointing this at a
# real endpoint with anything other than the synthetic fixtures.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Two tiers. FAST does extraction and labelling; the other does issue
# assessment, contradiction analysis, and drafting.
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL=gpt-5.6-sol
